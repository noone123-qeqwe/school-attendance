# Smart Classroom Attendance System - Render Configuration
# Copy this to Render environment variables

APP_NAME="Smart Classroom Attendance System"
APP_SUBTITLE="QR, GPS, and Biometric-Based Attendance Monitoring"
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=Asia/Manila
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# Logging (Render uses stderr)
LOG_CHANNEL=stderr
LOG_LEVEL=error

# Session & Cache (Database-based for scalability)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
TRUSTED_PROXIES=*   # Trust all proxies — safe behind managed PaaS (Render/Railway/Heroku)
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=reverb
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Mail Configuration (Configure with your SMTP settings)
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_FROM_NAME="Smart Classroom Attendance System"
# Add these in Render dashboard:
# MAIL_USERNAME=your_email@gmail.com
# MAIL_PASSWORD=your_app_password
# MAIL_FROM_ADDRESS=your_email@gmail.com

# SMS Configuration (Optional - Configure in Render dashboard)
# SEMAPHORE_API_KEY=your_semaphore_api_key
# SEMAPHORE_SENDER_NAME=AttendSys

# Reverb WebSocket Configuration
REVERB_APP_ID=attendance-prod
# Generate secure keys and add in Render dashboard:
# REVERB_APP_KEY=your_secure_reverb_key
# REVERB_APP_SECRET=your_secure_reverb_secret

# Render will auto-configure these database variables:
# DB_CONNECTION=mysql
# DB_HOST=
# DB_PORT=
# DB_DATABASE=
# DB_USERNAME=
# DB_PASSWORD=

# Render will auto-configure this:
# APP_URL=
# APP_KEY=