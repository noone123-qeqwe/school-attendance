# Smart Classroom Attendance System - Render Configuration# Copy this to Render environment variablesAPP_NAME="Smart Classroom Attendance System"APP_SUBTITLE="QR, GPS, and Biometric-Based Attendance Monitoring"APP_ENV=productionAPP_DEBUG=falseAPP_TIMEZONE=Asia/ManilaAPP_LOCALE=enAPP_FALLBACK_LOCALE=en# Logging (Render uses stderr)LOG_CHANNEL=stderrLOG_LEVEL=error# Session & Cache (Database-based for scalability)SESSION_DRIVER=fileSESSION_LIFETIME=120SESSION_ENCRYPT=trueSESSION_SECURE_COOKIE=trueTRUSTED_PROXIES=*   # Trust all proxies — safe behind managed PaaS (Render/Railway/Heroku)SESSION_SAME_SITE=laxBROADCAST_CONNECTION=reverbCACHE_STORE=fileQUEUE_CONNECTION=databaseFILESYSTEM_DISK=local# Mail Configuration (Configure with your SMTP settings)MAIL_MAILER=smtpMAIL_HOST=smtp.gmail.comMAIL_PORT=587MAIL_ENCRYPTION=tlsMAIL_FROM_NAME="Smart Classroom Attendance System"# Add these in Render dashboard:# MAIL_USERNAME=your_email@gmail.com# MAIL_PASSWORD=your_app_password# MAIL_FROM_ADDRESS=your_email@gmail.com# SMS Configuration (Optional - Configure in Render dashboard)# SEMAPHORE_API_KEY=your_semaphore_api_key# SEMAPHORE_SENDER_NAME=AttendSys# Reverb WebSocket ConfigurationREVERB_APP_ID=attendance-prod# Generate secure keys and add in Render dashboard:# REVERB_APP_KEY=your_secure_reverb_key# REVERB_APP_SECRET=your_secure_reverb_secret# Render will auto-configure these database variables:# DB_CONNECTION=mysql# DB_HOST=# DB_PORT=# DB_DATABASE=# DB_USERNAME=# DB_PASSWORD=# Render will auto-configure this:# APP_URL=# APP_KEY=