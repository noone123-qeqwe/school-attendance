APP_NAME="Smart Classroom Attendance System"APP_SUBTITLE="QR, GPS, and Biometric-Based Attendance Monitoring"APP_ENV=productionAPP_KEY=APP_DEBUG=falseAPP_URL=https://yourdomain.comAPP_TIMEZONE=Asia/ManilaAPP_LOCALE=enAPP_FALLBACK_LOCALE=enAPP_FAKER_LOCALE=en_USAPP_MAINTENANCE_DRIVER=fileBCRYPT_ROUNDS=12LOG_CHANNEL=stackLOG_STACK=singleLOG_DEPRECATIONS_CHANNEL=nullLOG_LEVEL=error# Production Database ConfigurationDB_CONNECTION=mysqlDB_HOST=127.0.0.1DB_PORT=3306DB_DATABASE=attendance_productionDB_USERNAME=attendance_userDB_PASSWORD=your_secure_password_hereSESSION_DRIVER=fileSESSION_LIFETIME=120SESSION_ENCRYPT=trueSESSION_PATH=/SESSION_DOMAIN=nullSESSION_SECURE_COOKIE=trueTRUSTED_PROXIES=*   # Trust all proxies — safe behind managed PaaS (Render/Railway/Heroku)SESSION_SAME_SITE=lax# Production Broadcasting (Reverb WebSocket)BROADCAST_CONNECTION=reverbFILESYSTEM_DISK=localQUEUE_CONNECTION=databaseCACHE_STORE=fileMEMCACHED_HOST=127.0.0.1REDIS_CLIENT=phpredisREDIS_HOST=127.0.0.1REDIS_PASSWORD=nullREDIS_PORT=6379# Production Mail ConfigurationMAIL_MAILER=smtpMAIL_SCHEME=nullMAIL_HOST=smtp.gmail.comMAIL_PORT=587MAIL_USERNAME=your_production_email@gmail.comMAIL_PASSWORD="your_app_password"MAIL_FROM_ADDRESS="your_production_email@gmail.com"MAIL_FROM_NAME="Smart Classroom Attendance System"# SMS Service (Production)SEMAPHORE_API_KEY=your_production_semaphore_keySEMAPHORE_SENDER_NAME=AttendSys# File Storage (Production)AWS_ACCESS_KEY_ID=AWS_SECRET_ACCESS_KEY=AWS_DEFAULT_REGION=us-east-1AWS_BUCKET=AWS_USE_PATH_STYLE_ENDPOINT=falseVITE_APP_NAME="${APP_NAME}"# Production Reverb WebSocket ConfigurationREVERB_APP_ID=attendance-prodREVERB_APP_KEY=your_production_reverb_keyREVERB_APP_SECRET=your_production_reverb_secretREVERB_HOST=yourdomain.comREVERB_PORT=443REVERB_SCHEME=httpsVITE_REVERB_APP_KEY="${REVERB_APP_KEY}"VITE_REVERB_HOST="${REVERB_HOST}"VITE_REVERB_PORT="${REVERB_PORT}"VITE_REVERB_SCHEME="${REVERB_SCHEME}"