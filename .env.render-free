APP_NAME="Smart Classroom Attendance System"
APP_SUBTITLE="QR, GPS, and Biometric-Based Attendance Monitoring"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-app-name.onrender.com
APP_TIMEZONE=Asia/Manila
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# SQLite Database (Free tier compatible)
DB_CONNECTION=sqlite
DB_DATABASE=/var/www/html/database/database.sqlite
DB_FOREIGN_KEYS=true

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
TRUSTED_PROXIES=*   # Trust all proxies — safe behind managed PaaS (Render/Railway/Heroku)
SESSION_SAME_SITE=lax

# File-based Broadcasting (Free tier)
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Email Configuration (Free Gmail SMTP)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_demo_email@gmail.com
MAIL_PASSWORD="your_app_password"
MAIL_FROM_ADDRESS="your_demo_email@gmail.com"
MAIL_FROM_NAME="Smart Classroom Attendance System"

# Demo SMS (Optional - use test keys)
SEMAPHORE_API_KEY=demo_key
SEMAPHORE_SENDER_NAME=DemoSys

VITE_APP_NAME="${APP_NAME}"

# File-based WebSocket (Free tier compatible)
REVERB_APP_ID=attendance-demo
REVERB_APP_KEY=demo-key-12345
REVERB_APP_SECRET=demo-secret-67890
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"