# Smart Classroom Attendance System
# Copy to .env, then generate APP_KEY with: php artisan key:generate

APP_NAME="Smart Classroom Attendance System"
APP_SUBTITLE="QR, GPS, and Biometric-Based Attendance Monitoring"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Manila
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_VERSION=9.1.4
APP_INSTALLED_VERSION=9.1.4
APP_CHANNEL=stable
APP_RELEASE_DATE=
APP_BUILD=1
APP_COMMIT=

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug
LOG_DEPRECATIONS_CHANNEL=null

# Required database connection. Use provider-managed secrets in production.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=attendance_db
DB_USERNAME=root
DB_PASSWORD=
DB_SSLMODE=

# Optional database URL or driver-specific tuning. Set only what your provider requires.
DATABASE_URL=
DB_URL=
MYSQL_URL=
DB_SOCKET=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_TIMEZONE=+00:00
DB_BUSY_TIMEOUT=5000

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=120
CACHE_STORE=file

SESSION_DRIVER=database
SESSION_LIFETIME=10080
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Optional Redis connection for shared cache, queue, and session storage.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_DB=0
REDIS_URL=

# Optional outbound email. Keep credentials in the deployment environment.
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=attendance@example.invalid
MAIL_FROM_NAME="${APP_NAME}"
MAIL_TIMEOUT=10

# Optional email API integration used by deployments that do not allow SMTP.
BREVO_API_KEY=
EMAIL_API_KEY=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_ENCRYPTION=tls
EMAIL_USER=
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=attendance@example.invalid
EMAIL_FROM_NAME="${APP_NAME}"
POSTMARK_API_KEY=
POSTMARK_MESSAGE_STREAM_ID=
RESEND_API_KEY=
RESEND_FROM=attendance@example.invalid

# Optional SMS. It is off by default; configure a real key before enabling it.
SMS_ENABLED=false
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=OsmenaAtt

# Optional cloud and notification integrations.
CLOUDINARY_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.invalid

# Reverb server and client must use the same app credentials and endpoint.
# These are safe placeholders for local setup; generate credentials for deployment.
REVERB_APP_ID=attendance-app
REVERB_APP_KEY=replace_with_reverb_app_key
REVERB_APP_SECRET=replace_with_reverb_app_secret
REVERB_ALLOWED_ORIGINS=localhost,127.0.0.1
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
REVERB_SERVER=reverb
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_SERVER_PATH=
REVERB_SCALING_ENABLED=false
REVERB_MAX_REQUEST_SIZE=10000
REVERB_APP_PING_INTERVAL=60
REVERB_APP_ACTIVITY_TIMEOUT=30
REVERB_APP_ACCEPT_CLIENT_EVENTS_FROM=members
REVERB_APP_RATE_LIMITING_ENABLED=false

# Optional alternative broadcasters and log/queue providers.
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
ABLY_KEY=
SLACK_BOT_USER_OAUTH_TOKEN=
SLACK_BOT_USER_DEFAULT_CHANNEL=

# Optional local tunnel and face-matcher model configuration.
NGROK_AUTHTOKEN=
FACE_MATCH_PYTHON=python3
FACE_MATCH_DETECTOR_MODEL=/opt/face-models/yunet.onnx
FACE_MATCH_RECOGNIZER_MODEL=/opt/face-models/sface.onnx
FACE_MATCH_THRESHOLD=

# Optional peer verification service settings.
PEER_SNAP_ENABLED=false
PEER_FACE_VERIFIER_URL=
PEER_FACE_VERIFIER_TOKEN=
PEER_FACE_MODEL_VERSION=
PEER_FACE_MATCH_THRESHOLD=
PEER_PAD_THRESHOLD=
PEER_MAX_FAILED_ATTEMPTS=5
PEER_LOCKOUT_MINUTES=15
PEER_PRESENCE_FRESH_SECONDS=30
PEER_VERIFICATION_TTL_SECONDS=120
MAX_PEER_VOUCHES_PER_HOST_PER_SESSION=3

# Optional deployment and security settings.
TRUSTED_PROXIES=
ASSET_URL=
ATTENDANCE_START_GRACE_MINUTES=10
QR_TOKEN_TTL=30
QR_MAX_MANUAL_REGENERATIONS=3
API_TOKEN_LIFETIME_DAYS=30
SEED_ADMIN_PASSWORD=
